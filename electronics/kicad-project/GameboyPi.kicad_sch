	(global_label "VBAT" (shape passive) (at 261.62 266.7 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "4ff29603-6ab0-4eda-bc63-5ea5be89c446"))
	(text "GameboyPi - Raspberry Pi Zero 2 W Handheld im Game-Boy-Color-Format" (exclude_from_sim no) (at 200.66 30.48 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "0850698a-42b0-444f-baff-5d4c33cf2ea9"))
	(text "Strom: LiPo 1S (mit Schutz) -> PowerBoost 1000C (Laden + Load-Sharing + 5.2V Boost) -> +5V" (exclude_from_sim no) (at 200.66 35.56 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "3feaaa5d-c466-4bc6-a08f-3c3a703394ec"))
	(text "Soft-Power: SW9 EIN haelt PWR_REQ low -> Q1 aus -> EN high. SW9 AUS -> GPIO16 low -> Pi faehrt herunter," (exclude_from_sim no) (at 200.66 40.64 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "eb3aaa75-9a58-473f-a16d-514530d98a0e"))
	(text "  danach GPIO4 (gpio-poweroff) low -> Q2 aus -> R8 zieht PWR_REQ high -> Q1 zieht EN low -> Boost aus." (exclude_from_sim no) (at 200.66 45.72 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "29416536-fa0a-48e3-8160-03f959e1d8a9"))
	(text "Display: 2.4in ILI9341 SPI an SPI0 (CE0), DC=GPIO25, RST=GPIO24, Backlight an 3V3" (exclude_from_sim no) (at 200.66 50.8 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "40af7086-cf1b-4ad5-ac2b-321396fd754d"))
	(text "Audio: PWM GPIO12/13 -> RC-Filter -> Klinke (Schaltkontakte) -> Mix -> RV1 Lautstaerke -> PAM8302 -> Lautsprecher" (exclude_from_sim no) (at 200.66 55.88 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "8f161e16-2c21-4702-a9cc-f198e0ec2aef"))
	(text "Tasten gegen GND, interne Pull-ups: UP=5 DOWN=6 LEFT=19 RIGHT=26 A=23 B=22 START=17 SELECT=27" (exclude_from_sim no) (at 200.66 60.96 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "9ca2f692-04af-4abe-b4b9-3246930db08e"))
	(text "Akku: ADS1115 AIN0 = VBAT/2 (I2C 0x48), LBO ueber BAT85 an GPIO20, UART-Debug an J8" (exclude_from_sim no) (at 200.66 66.04 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid "265faffa-46d4-4242-a077-59b55d965396"))
